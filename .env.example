# ==============================================================================
# Environment Configuration Template
# Copy this file to .env in backend/ or root as needed during local development.
# DO NOT commit real secrets or credentials to version control.
# ==============================================================================

# Node Environment ('development' | 'production' | 'test')
NODE_ENV=development

# Backend Server Port (Port 5001 avoids macOS AirPlay receiver conflict on 5000)
PORT=5001

# Allowed Frontend URL for CORS (no trailing slash)
FRONTEND_URL=http://localhost:5173

# Future RAG / LLM Integration (Phase 3+)
# GEMINI_API_KEY=
# LLM_MODEL=gemini-1.5-flash
