# ==============================================================================
# Environment Configuration Template
# Copy this file to .env in backend/ or root as needed during local development.
# DO NOT commit real secrets or credentials to version control.
# ==============================================================================

# Node Environment ('development' | 'production' | 'test')
NODE_ENV=development

# Backend Server Port (Port 5001 avoids macOS AirPlay receiver conflict on 5000)
PORT=5001

# Allowed Frontend URL for CORS (no trailing slash)
FRONTEND_URL=http://localhost:5173

# Profile-Aware RAG AI Chatbot Configuration
GEMINI_API_KEY=
LLM_PROVIDER=gemini
LLM_MODEL=gemini-3.5-flash
EMBEDDING_PROVIDER=gemini
EMBEDDING_MODEL=gemini-embedding-001
CHAT_TOP_K=4
CHAT_RATE_LIMIT=20
CHAT_RATE_WINDOW_MS=900000
